# Optional GitHub token for higher rate limits.
GITHUB_TOKEN=
MAX_REPOS=5
FETCH_IMPORTANT_FILES=false
CORS_ALLOW_ORIGINS=https://bebecpp.github.io,http://localhost:8000,http://127.0.0.1:8000

# Optional real AI report generation.
# "auto" tries OpenAI first, then Gemini, then fallback.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
